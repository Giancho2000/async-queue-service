enum JobType {
  TEST
  EMAIL
  REPORT
}

enum JobStatus {
  PENDING   // created, waiting in the queue
  PROCESSING  // the Worker is executing it
  COMPLETED  // finished OK
  FAILED // ran out of retries
  CANCELLED // cancelled before execution
}

enum JobPriority {
  HIGH
  MEDIUM
  LOW
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id        String        @id @default(uuid())
  type      JobType
  status    JobStatus     @default(PENDING)
  priority  JobPriority   @default(MEDIUM)

  payload   Json
  result    Json?
  error     String?

  attempts    Int   @default(0)   // attempts already executed
  maxAttempts Int   @default(4)   // max attempts allowed

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([type])
  @@index([status, priority])
  @@map("jobs")
}